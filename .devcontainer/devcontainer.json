{
  "name": "pytest-airflow-in-a-box",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "PYTHON_VERSION": "3.12",
      "UV_VERSION": "0.12.2"
    }
  },
  "containerEnv": {
    "TMPDIR": "/tmp/pytest-airflow-in-a-box",
    "UV_LINK_MODE": "copy"
  },
  "remoteUser": "vscode",
  "postCreateCommand": "uv sync --locked && uv run prek install"
}
